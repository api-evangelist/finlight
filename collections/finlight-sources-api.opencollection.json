{
  "opencollection": "1.0.0",
  "info": {
    "name": "Finlight Financial News Articles Sources API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Available News Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.finlight.me/v2/sources"
          },
          "docs": "Retrieve all available news sources with metadata including domain, content availability, and whether the source is included in the default source set."
        }
      ]
    }
  ],
  "bundled": true
}